# ===== 项目管理数据（非交付物，切勿上传）=====
.workbuddy-ai/

# ===== 前端 =====
node_modules/
package-lock.json
npm-debug.log*

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# ===== 运行时生成的产物 =====
.env
.env.*
!.env.example
listing_payloads.json
# 状态文件本身 + 它的衍生文件(锁 / 原子写临时文件 / 损坏备份)
state.json
state.json.lock
state.json.tmp
state.json.broken
*.log

# 指标历史库(运行时生成,WAL 模式还会带 -wal / -shm 两个影子文件)
history.db
history.db-wal
history.db-shm
image_library.db
image_library.db-wal
image_library.db-shm

# 生成器的原子写临时文件
*.js.tmp

# 转存的生成图(运行时产物,体积大且可重新生成)+ 原子写残留
python_backend/images/
*.part

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini
